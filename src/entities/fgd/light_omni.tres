[sub_resource type="GDScript" id="GDScript_uench"]
script/source = "@tool
extends OmniLight3D

func _func_godot_apply_properties(props: Dictionary):
	if \"energy\" in props:
		light_energy = props[\"energy\"]
	if \"_color\" in props:
		light_color = props[\"_color\"]
	if \"shadows\" in props:
		shadow_enabled = props[\"shadows\"]
		
	if \"atten\" in props:
		omni_attenuation = props[\"atten\"]
	if \"range\" in props:
		omni_range = props[\"range\"]
"

