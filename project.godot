config_version=5

[application]

config/name="gdtemplate"
run/main_scene="uid://c038d87h6jovr"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

LimboConsole="*uid://dyxornv8vwibg"
Events="*uid://bay0w8uiv72bu"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/func_godot/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/limbo_console/plugin.cfg", "res://addons/yard/plugin.cfg")

[func_godot]

